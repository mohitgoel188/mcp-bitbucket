# Reference list of every setting this server reads.
#
# The server does NOT load .env files -- MCP clients start it with a minimal
# environment and do not pass one through. Copy the values you need into the
# `env` block of your MCP client configuration. See README > Configuration.
#
# Preferred for the credential: export it from your shell profile and reference
# it in the client config as "${BITBUCKET_TOKEN}", so the secret never sits in
# a file that might be committed or shared. Literal values work too.
#
# Credentials -- provide EITHER a token (preferred) OR username + app password.
# A token wins when both are set.
BITBUCKET_TOKEN=your-api-token

# Legacy app-password mode.
# BITBUCKET_USERNAME=your-username
# BITBUCKET_APP_PASSWORD=your-app-password

# Targeting. Both are auto-detected from the git remote inside a Bitbucket
# checkout, and required otherwise. There is no built-in default workspace.
# BITBUCKET_WORKSPACE=your-workspace
# BITBUCKET_REPO_SLUG=your-repo
# BITBUCKET_PROJECT_DIR=/path/to/some/checkout

# Safety switches. Defaults shown; both are deliberately restrictive.
# BITBUCKET_BB_REQUEST_READONLY=true
# BITBUCKET_ALLOW_DESTRUCTIVE=false

# Diagnostics. Logging writes request bodies verbatim -- see README > Security.
# BITBUCKET_ENABLE_REQUEST_LOGGING=false
# BITBUCKET_REQUEST_LOG_FILE=bitbucket_requests.log

# Tuning. Defaults shown.
# BITBUCKET_MAX_PAGINATED_PAGES=20
# BITBUCKET_REQUEST_TIMEOUT_SECONDS=120

# Live integration tests only. These CREATE AND DELETE REAL REPOSITORIES.
# BITBUCKET_TEST_WORKSPACE=your-scratch-workspace
